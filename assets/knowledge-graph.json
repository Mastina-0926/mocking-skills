      "type": "era",
      "stars": 0,
      "school": "",
      "tagline": "",
      "detail": "清代前中期文学批评的特点：明清易代后反思明代文学之弊，“返经”思潮兴起，集大成倾向明显。",
      "era": "清代前中期",
      "color": "#4a7c59"
    },
    {
      "id": "song-lian",
      "name": "宋濂",
      "type": "person",
      "stars": 2,
      "school": "明初",
      "tagline": "“明道之谓文，立教之谓文”",
      "detail": "明初“开国文臣之首”。主张文道合一、宗经师古。将文分为三等：立德之文为上，明道之文为中，失道之文为下。但又存在矛盾：反对摹拟，主张“自然成文”；赞赏苏轼、杨维桢等非正统文人。",
      "era": "明代",
      "color": "#9b4b3e"
    },
    {
      "id": "li-mengyang",
      "name": "李梦阳",
      "type": "person",
      "stars": 2,
      "school": "前七子",
      "tagline": "“文必秦汉，诗必盛唐”",
      "detail": "前七子领袖，打出“文必秦汉，诗必盛唐”口号，以渊奥文辞和高古格调打倒了台阁体。“尺寸古法”强调严格摹拟古人。晚年幡然醒悟：“真诗果在民间”，自谴其诗是“出之情寡而工之词多者也”。",
      "era": "明代",
      "color": "#9b4b3e"
    },
    {
      "id": "he-jingming",
      "name": "何景明",
      "type": "person",
      "stars": 2,
      "school": "前七子",
      "tagline": "“富于材积，领会神情，临景构结，不仿形迹”",
      "detail": "前七子成员。反对李梦阳“刻意古范”，主张“富于材积，领会神情，临景构结，不仿形迹”。倡言“诗文之法亡于韩愈”。",
      "era": "明代",
      "color": "#9b4b3e"
    },
    {
      "id": "xu-zhenqing",
      "name": "徐祯卿",
      "type": "person",
      "stars": 1,
      "school": "前七子",
      "tagline": "“因情立格”说",
      "detail": "前七子。“因情立格”说，明确肯定情与格的主从关系，识见出李梦阳之上。",
      "era": "明代",
      "color": "#9b4b3e"
    },
    {
      "id": "wang-shizhen-ming",
      "name": "王世贞",
      "type": "person",
      "stars": 2,
      "school": "后七子",
      "tagline": "后七子领袖，晚年有所追悔",
      "detail": "后七子领袖，重复前七子的复古路线。晚年对自己前期论点有所追悔，发表折衷言论。论曲侧重作品艺术感染力。",
      "era": "明代",
      "color": "#9b4b3e"
    },
    {
      "id": "tangsong-pai",
      "name": "唐宋派",
      "type": "school",
      "stars": 3,
      "school": "",
      "tagline": "学习唐宋八大家，提倡平易自然",
      "detail": "王慎中、唐顺之、茅坤、归有光。继承宋濂取径韩、欧之说，提倡学习“唐宋八家”散文的神理和平易自然风格语言，与“文必秦汉”之说相峙。唐顺之“本色”论：文章应“直据胸臆”，有“真精神与千古不可磨灭之见”。影响深远至桐城派。",
      "era": "明代",
      "color": "#6b5b95"
    },
    {
      "id": "li-zhi",
      "name": "李贽",
      "type": "person",
      "stars": 3,
      "school": "泰州学派",
      "tagline": "“童心说”——“天下之至文，未有不出于童心焉者也”",
      "detail": "泰州学派杰出代表。提出“童心说”，认为优秀戏曲、小说皆可成“天下之至文”。评点《水浒传》，将它与《史记》、杜诗相提并论，提高小说地位。以天然本色为曲之最上乘。主张创作离不开激情。",
      "era": "明代",
      "color": "#9b4b3e"
    },
    {
      "id": "yuan-hongdao",
      "name": "袁宏道",
      "type": "person",
      "stars": 3,
      "school": "公安派",
      "tagline": "“独抒性灵，不拘格套”",
      "detail": "公安派领袖，深受李贽影响。核心口号：“独抒性灵，不拘格套”。强调文学的时代性和个性化：文学和语言不断发展变化。要求创作具有真情实感，使用当时语言，反对陈规旧套。猛烈涤荡拟古文风。",
      "era": "明代",
      "color": "#9b4b3e"
    },
    {
      "id": "zhong-xing",
      "name": "钟惺",
      "type": "person",
      "stars": 2,
      "school": "竟陵派",
      "tagline": "“求古人真诗之所在”",
      "detail": "竟陵派领袖（与谭元春）。继承公安派反对前后七子拟古，试图矫正公安末流轻佻浅率的偏失。提倡“幽深孤峭”的风格。“求古人真诗之所在”，将求真与学古结合。",
      "era": "明代",
      "color": "#9b4b3e"
    },
    {
      "id": "chen-zilong",
      "name": "陈子龙",
      "type": "person",
      "stars": 1,
      "school": "明末",
      "tagline": "“情与境会”，爱国忧时",
      "detail": "明末。突破形式拟古的窠臼，发扬司马迁“发愤著书”精神，强调文学抒写爱国忧时的怀抱与讽刺时事的作用。注重“情与境会”——真情与现实环境密切联系。",
      "era": "明代",
      "color": "#9b4b3e"
    },
    {
      "id": "xu-wei",
      "name": "徐渭",
      "type": "person",
      "stars": 3,
      "school": "明代曲论",
      "tagline": "“贱相色，贵本色”",
      "detail": "《南词叙录》——我国第一部南戏专论。提倡“本色”——“贱相色，贵本色”。反对文人鄙视南戏。“曲本取于感发人心，歌之使奴童妇女皆喻”。注意戏曲的舞台搬演特点。",
      "era": "明代",
      "color": "#6b5b95"
    },
    {
      "id": "shen-jing",
      "name": "沈璟",
      "type": "person",
      "stars": 3,
      "school": "吴江派",
      "tagline": "“宁使时人不鉴赏，无使人挠喉捩嗓”",
      "detail": "吴江派领袖。偏重艺术形式：严守格律，恪遵成式，四声阴阳、句式、用韵必须一丝不苟。要求戏曲语言通俗本色，恢复元曲传统。指责汤显祖“临川四梦”不谐音律。",
      "era": "明代",
      "color": "#6b5b95"
    },
    {
      "id": "tang-xianzu",
      "name": "汤显祖",
      "type": "person",
      "stars": 3,
      "school": "临川派",
      "tagline": "“神情合至”，以“情”为戏曲冲突基础",
      "detail": "临川派领袖。创作重视“意趣”，驰骋才情。突出强调“情”在作品中的主导位置，提倡“神情合至”。把“情”与“理”的矛盾对立视为戏曲矛盾冲突的基础，对现实持悲愤批评的态度。",
      "era": "明代",
      "color": "#6b5b95"
    },
    {
      "id": "wang-jide",
      "name": "王骥德",
      "type": "person",
      "stars": 3,
      "school": "明代曲论",
      "tagline": "“法与词必两擅其极”",
      "detail": "《曲律》——明代戏曲理论的集大成之作。折衷吴江临川两派：“法与词必两擅其极”。“论曲，当看其全体力量如何”。提出“大头脑”——抓住作品总倾向。“纯用本色，易觉寂寥；纯用文词，复伤雕镂”。",
      "era": "明代",
      "color": "#6b5b95"
    },
    {
      "id": "qian-qianyi",
      "name": "钱谦益",
      "type": "person",
      "stars": 2,
      "school": "清初文坛领袖",
      "tagline": "“返经”论",
      "detail": "清初文坛领袖。提出“返经”论——以“六经”为源头，诗文分别以《三百篇》和六经为“祖”。文学三要素说：“灵心、世运、学问”三者相值。批判明人争论秦汉/唐宋是“离开源头在支流末节翻跟斗”。",
      "era": "清代前中期",
      "color": "#4a7c59"
    },
    {
      "id": "huang-zongxi",
      "name": "黄宗羲",
      "type": "person",
      "stars": 3,
      "school": "明清之际",
      "tagline": "发扬“发愤著书”精神",
      "detail": "明清之际思想家。发扬“发愤著书”精神，强调文学的时代性、批判性。重视诗歌的抒情本质。",
      "era": "清代前中期",
      "color": "#4a7c59"
    },
    {
      "id": "gu-yanwu",
      "name": "顾炎武",
      "type": "person",
      "stars": 3,
      "school": "明清之际",
      "tagline": "“文须有益于天下”",
      "detail": "明清之际思想家。“文须有益于天下”——强调文学的社会功用。提出“经世致用”的文学观。《日知录》中的文学批评思想。",
      "era": "清代前中期",
      "color": "#4a7c59"
    },
    {
      "id": "wang-fuzhi",
      "name": "王夫之",
      "type": "person",
      "stars": 3,
      "school": "明清之际",
      "tagline": "“情景名为二，而实不可离”",
      "detail": "明清之际哲学家。情景交融论——诗中最核心的理论：“情景名为二，而实不可离”。“现量”说：诗歌应直接呈现直觉体验。重视诗歌的“兴观群怨”功能。对明代复古派和性灵派都有批判。",
      "era": "清代前中期",
      "color": "#4a7c59"
    },
    {
      "id": "fang-bao",
      "name": "方苞",
      "type": "person",
      "stars": 3,
      "school": "桐城派",
      "tagline": "“义法”说——“言有物”“言有序”",
      "detail": "桐城派始祖。“义法”说——桐城派文论核心。“义”即“言有物”（内容），“法”即“言有序”（形式）。强调文章内容与形式的统一。取径唐宋八大家。",
      "era": "清代前中期",
      "color": "#4a7c59"
    },
    {
      "id": "liu-dakui",
      "name": "刘大櫆",
      "type": "person",
      "stars": 2,
      "school": "桐城派",
      "tagline": "“因声求气”",
      "detail": "桐城派。发展“义法”说，注重“神气”。提出“因声求气”——通过诵读体会文章气势。",
      "era": "清代前中期",
      "color": "#4a7c59"
    },
    {
      "id": "yao-nai",
      "name": "姚鼐",
      "type": "person",
      "stars": 3,
      "school": "桐城派",
      "tagline": "“义理、考据、辞章”三者合一",
      "detail": "桐城派集大成者。“义理、考据、辞章”三者合一——桐城派文论的巅峰。《古文辞类纂》——桐城派经典选本。“阴阳刚柔”说——文章风格的分类理论。",
      "era": "清代前中期",
      "color": "#4a7c59"
    },
    {
      "id": "zhang-xuecheng",
      "name": "章学诚",
      "type": "person",
      "stars": 3,
      "school": "史学家",
      "tagline": "“六经皆史”",
      "detail": "《文史通义》——重要的文史理论著作。“六经皆史”——打破经学神圣地位。“文德”说——“临文必敬，论古必恕”。反对桐城派文论，提倡学问与文章结合。",
      "era": "清代前中期",
      "color": "#4a7c59"
    },
    {
      "id": "wang-shizhen-qing",
      "name": "王士禛",
      "type": "person",
      "stars": 3,
      "school": "清初诗坛",
      "tagline": "“神韵”说",
      "detail": "清初诗坛盟主。“神韵”说——以“不著一字，尽得风流”为最高境界。推崇盛唐王维、孟浩然一派的风格。提倡含蓄蕴藉、冲和淡远的诗风。继承严羽“妙悟”说。",
      "era": "清代前中期",
      "color": "#4a7c59"
    },
    {
      "id": "ye-xie",
      "name": "叶燮",
      "type": "person",
      "stars": 3,
      "school": "清初诗论",
      "tagline": "《原诗》——“理事情”与“才胆识力”",
      "detail": "《原诗》——清代最重要的诗论专著。提出创作四大要素：“理、事、情”（理=道理，事=事物，情=情态）。诗人应具备四种能力：“才、胆、识、力”，“识”居首位。系统性、理论性的诗论体系。",
      "era": "清代前中期",
      "color": "#4a7c59"
    },
    {
      "id": "shen-deqian",
      "name": "沈德潜",
      "type": "person",
      "stars": 3,
      "school": "乾隆诗坛",
      "tagline": "“格调”说——崇尚唐诗格律",
      "detail": "乾隆时期诗坛盟主。“格调”说——崇尚唐诗的格律和风格。重视诗歌的“温柔敦厚”传统。提倡“诗教”——诗歌的社会教化功能。与王士禛的“神韵”说形成互补。",
      "era": "清代前中期",
      "color": "#4a7c59"
    },
    {
      "id": "yuan-mei",
      "name": "袁枚",
      "type": "person",
      "stars": 3,
      "school": "乾隆诗坛",
      "tagline": "“性灵”说——“诗者，人之性情也”",
      "detail": "乾隆时期。“性灵”说——“诗者，人之性情也”。反对沈德潜的“格调”说，批判温柔敦厚教条。主张诗写个人真实性情，不拘一格。《随园诗话》——性灵说的代表著作。与公安派“独抒性灵”一脉相承。",
      "era": "清代前中期",
      "color": "#4a7c59"
    },
    {
      "id": "weng-fanggang",
      "name": "翁方纲",
      "type": "person",
      "stars": 2,
      "school": "乾隆诗坛",
      "tagline": "“肌理”说",
      "detail": "乾隆时期。“肌理”说——“为学必以考证为准，为诗必以肌理为准”。强调学问和考据对诗歌的重要性。",
      "era": "清代前中期",
      "color": "#4a7c59"
    },
    {
      "id": "zhang-huiyan",
      "name": "张惠言",
      "type": "person",
      "stars": 3,
      "school": "常州词派",
      "tagline": "“意内言外”——词应寄托深远",
      "detail": "常州词派创始人。“意内言外”说——词应寄托深远。编《词选》——开创常州词派。强调词体的“比兴寄托”功能。",
      "era": "清代前中期",
      "color": "#4a7c59"
    },
    {
      "id": "zhou-ji",
      "name": "周济",
      "type": "person",
      "stars": 3,
      "school": "常州词派",
      "tagline": "“词亦有史”——“非寄托不入，专寄托不出”",
      "detail": "常州词派发展者。提出“词亦有史”——词的发展有内在历史。“寄托出入”说——“夫词，非寄托不入，专寄托不出”。发展了张惠言的理论。",
      "era": "清代前中期",
      "color": "#4a7c59"
    },
    {
      "id": "li-yu",
      "name": "李渔",
      "type": "person",
      "stars": 3,
      "school": "清代戏曲",
      "tagline": "《闲情偶寄》——“结构第一”",
      "detail": "《闲情偶寄》——中国古代戏曲理论最系统、最完整的著作。“结构第一”——把结构放在戏曲创作的首位（打破传统“音律第一”观念）。“立主脑”——“一人一事”贯穿全剧。“密针线”——情节要针线紧密。“减头绪”——主线清晰。",
      "era": "清代前中期",
      "color": "#4a7c59"
    },
    {
      "id": "jin-shengtan",
      "name": "金人瑞（金圣叹）",
      "type": "person",
      "stars": 3,
      "school": "清初批评家",
      "tagline": "“澄怀格物，因缘生法”",
      "detail": "评点《西厢记》《水浒传》，影响深远。提出“因缘生法”——人物性格源于环境和因缘。“澄怀格物”——创作前要静心观察事物。“临文动心”——创作时全身心投入。第一个明确提出以人物形象塑造为评价标准。",
      "era": "清代前中期",
      "color": "#4a7c59"
    },
