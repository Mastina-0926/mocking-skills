      "id": "gui-youguang",
      "name": "归有光",
      "type": "person",
      "stars": 2,
      "school": "唐宋派",
      "tagline": "“唐宋派代表，清代桐城派先声”",
      "detail": "“明代散文大家，唐宋派重要代表。继承唐宋八大家传统，散文风格平易自然。其文论对清代桐城派有直接影响。”",
      "era": "明代",
      "color": "#9b4b3e"
    },
    {
      "id": "tang-shunzhi",
      "name": "唐顺之",
      "type": "person",
      "stars": 2,
      "school": "唐宋派",
      "tagline": "““本色”论——文章应“直据胸臆””",
      "detail": "“唐宋派代表人物。提出“本色”论，主张文章应“直据胸臆”，有“真精神与千古不可磨灭之见”。同时几乎否定了艺术形式的作用，是其局限。”",
      "era": "明代",
      "color": "#9b4b3e"
    },
    {
      "id": "mao-kun",
      "name": "茅坤",
      "type": "person",
      "stars": 2,
      "school": "唐宋派",
      "tagline": "“编纂《唐宋八大家文钞》”",
      "detail": "“唐宋派代表人物。编纂《唐宋八大家文钞》，对确立唐宋八大家在文学史上的经典地位起了关键作用。其文论主张与王慎中、唐顺之一致。”",
      "era": "明代",
      "color": "#9b4b3e"
    },
    {
      "id": "pu-songling",
      "name": "蒲松龄",
      "type": "person",
      "stars": 3,
      "school": "清初小说",
      "tagline": "“《聊斋志异》——“以泄愤懑，抒写愁思””",
      "detail": "“清初小说家（《聊斋志异》作者）。其作品“驰幻妄，光怪陆离”，成功“以泄愤懑，抒写愁思”，具有强烈批判现实的精神。余集序言高度评价其创作精神。关于《聊斋志异》的评论推进了浪漫主义小说理论的深化。”",
      "era": "清代前中期",
      "color": "#4a7c59"
    },
    {
      "id": "ji-yun",
      "name": "纪昀",
      "type": "person",
      "stars": 2,
      "school": "清初小说",
      "tagline": "“《阅微草堂笔记》作者，与《聊斋》对峙”",
      "detail": "“清代学者、小说家（纪晓岚）。《阅微草堂笔记》作者，与蒲松龄《聊斋志异》的创作路数不同。对《聊斋》的评论代表了清代小说批评的另一重要声音。”",
      "era": "清代前中期",
      "color": "#4a7c59"
    },
    {
      "id": "yu-ji",
      "name": "余集",
      "type": "person",
      "stars": 1,
      "school": "小说批评",
      "tagline": "“《聊斋志异序》——“以泄愤懑，抒写愁思””",
      "detail": "“清代学者，为《聊斋志异》作序。指出蒲松龄创作《聊斋》的动机是“以泄愤懑，抒写愁思”，具有强烈批判现实的精神。”",
      "era": "清代前中期",
      "color": "#4a7c59"
    },
    {
      "id": "zhang-daoshen",
      "name": "张道深",
      "type": "person",
      "stars": 2,
      "school": "小说评点",
      "tagline": "“《批评第一奇书金瓶梅读法》——“情理”二字”",
      "detail": "“清代小说评点家（号竹坡）。评点《金瓶梅》，在晚明小说论基础上更鲜明地提出“做文章不过情理二字”。认为“稗官者，寓言也，其假捏一人，幻造一事”——认识到小说的虚构性。”",
      "era": "清代前中期",
      "color": "#4a7c59"
    },
    {
      "id": "jin-feng",
      "name": "金丰",
      "type": "person",
      "stars": 1,
      "school": "小说理论",
      "tagline": "““实者虚之，虚者实之”——虚实结合”",
      "detail": "“清代小说批评家。在《说岳全传序》中提出“实者虚之，虚者实之”，认为虚实结合、相互补充才能写好小说。对于理解现实主义与浪漫主义的不同创作方法及其结合有启发性。”",
      "era": "清代前中期",
      "color": "#4a7c59"
    },
    {
      "id": "huang-yue",
      "name": "黄越",
      "type": "person",
      "stars": 1,
      "school": "小说理论",
      "tagline": "“小说可“无者造之而使有””",
      "detail": "“清代小说批评家。在《第九才子书平鬼传序》中提出小说可以“无者造之而使有，有者化之而使无”，认识到艺术形象本是虚构的，经过艺术创造就成为“有”。反映了对艺术典型特征的认识。”",
      "era": "清代前中期",
      "color": "#4a7c59"
    },
    {
      "id": "wu-yiyi",
      "name": "吴仪一",
      "type": "person",
      "stars": 1,
      "school": "清代戏曲",
      "tagline": "“评点《长生殿》，戏曲批评家”",
      "detail": "“清初戏曲批评家。评点洪升《长生殿》，在戏曲批评上有一定贡献。”",
      "era": "清代前中期",
      "color": "#4a7c59"
    },
    {
      "id": "liu-tingji",
      "name": "刘廷玑",
      "type": "person",
      "stars": 1,
      "school": "清代戏曲",
      "tagline": "“清代曲论家”",
      "detail": "“清初文人、曲论家。在戏曲批评上有所建树。”",
      "era": "清代前中期",
      "color": "#4a7c59"
    },
    {
      "id": "zhaoyi",
      "name": "赵翼",
      "type": "person",
      "stars": 2,
      "school": "清代诗论",
      "tagline": "““江山代有才人出，各领风骚数百年””",
      "detail": "“清代史学家、诗人。论诗主张创新，反对盲目拟古。“江山代有才人出，各领风骚数百年”——强调每个时代都应有自己的文学成就。与袁枚的性灵说有相通之处。”",
      "era": "清代前中期",
      "color": "#4a7c59"
    },
    {
      "id": "wang-wan",
      "name": "汪琬",
      "type": "person",
      "stars": 1,
      "school": "清初文人",
      "tagline": "“清初古文三大家之一”",
      "detail": "“清初散文家（与侯方域、魏禧并称“清初三大家”）。论文主张纯正典雅，与侯方域、魏禧风格各异，代表了清初散文的不同取向。”",
      "era": "清代前中期",
      "color": "#4a7c59"
    },
    {
      "id": "zha-shenxing",
      "name": "查慎行",
      "type": "person",
      "stars": 1,
      "school": "清初诗坛",
      "tagline": "“清初宋诗派代表”",
      "detail": "“清初诗人，宋诗派的重要代表。推崇宋诗，在清代诗坛有一定地位。”",
      "era": "清代前中期",
      "color": "#4a7c59"
    },
    {
      "id": "chen-tang",
      "name": "陈廷焯",
      "type": "person",
      "stars": 2,
      "school": "清代词论",
      "tagline": "“《白雨斋词话》——词学理论家”",
      "detail": "“清代词论家。所著《白雨斋词话》是重要的词学理论著作，发展了常州词派的理论。提出“沉郁”说，对词的艺术特征有深入分析。”",
      "era": "清代前中期",
      "color": "#4a7c59"
    },
    {
      "id": "tan-xian",
      "name": "谭献",
      "type": "person",
      "stars": 2,
      "school": "清代词论",
      "tagline": "“复堂词话，常州词派发展”",
      "detail": "“清代词论家，常州词派的重要发展者。在词学理论上承接张惠言、周济，进一步阐发常州词派的“寄托”理论。”",
      "era": "清代前中期",
      "color": "#4a7c59"
    },
    {
      "id": "wu-meicun",
      "name": "吴梅村",
      "type": "person",
      "stars": 2,
      "school": "清初诗坛",
      "tagline": "“清初诗坛大家，与钱谦益并称”",
      "detail": "“清初诗人（吴伟业，号梅村）。在诗歌批评上有所建树，与钱谦益、龚鼎孳并称“江左三大家”。”",
      "era": "清代前中期",
      "color": "#4a7c59"
    }
  ],
